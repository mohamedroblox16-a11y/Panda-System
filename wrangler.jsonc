{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "panda-system",
  "main": "src/index.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/interactions"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "panda-system-db",
      "database_id": "abf9be1d-b6b2-45e2-8ffc-a47071b7bb17"
    }
  ],
  "vars": {
    "DISCORD_APPLICATION_ID": "SET_IN_CLOUDFLARE",
    "PUBLIC_BASE_URL": "https://YOUR-WORKER.YOUR-SUBDOMAIN.workers.dev"
  }
}
